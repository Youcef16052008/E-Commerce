# Environment dedicated to an isolated, disposable PostgreSQL + Stripe TEST account.
# Copy locally to .env.test. Do not commit .env.test and never point it to development
# or production: integration tests create and delete data.

DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/biblio_test?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-test-only-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Stripe test-mode credentials only. The application rejects sk_live_/rk_live_.
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_TAX_CODE=""

# Required only by integration tests that exercise signed URLs/storage.
STORAGE_ACCOUNT_ID=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="biblio-test"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_FORCE_PATH_STYLE="true"
