# ---- Base de données (Neon postgres) ----
# Connexion string PostgreSQL. En local : base locale ou Neon (gratuit).
DATABASE_URL="postgres://user:pass@localhost:5432/biblio"

# ---- Better Auth ----
# Secret utilisé pour signer les sessions/tokens. Génère-le avec : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-generate-a-long-random-string"

# URL de base du site (sans slash final). Laisser vide pour une auto-détection de fallback.
BETTER_AUTH_URL="http://localhost:3000"

# ---- Stripe (mode TEST uniquement) ----
# Clés de test depuis https://dashboard.stripe.com/test/apikeys
# Clés de test depuis https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
# Secret du webhook Stripe, disponible via `stripe listen` ou dans le dashboard (test)
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Code fiscal produit (option). Laissez vide pour désactiver Managed Payments (mode test sans taxe).
# Si votre compte exige une TVA, renseignez un `tax_code` Stripe éligible (ex. txcd_...).
STRIPE_TAX_CODE=""

# ---- Stockage objet (R2 / S3) pour les fichiers e-books ----
# Créez un bucket R2 (Cloudflare) ou un bucket S3 compatible. Le code génère des
# URLs pré-signées à durée limitée côté serveur (aucun fichier via le client).
# STORAGE_ENDPOINT peut être défini à la place de STORAGE_ACCOUNT_ID.
STORAGE_ACCOUNT_ID=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="biblio"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
# En mode "stockage auto-hébergé / MinIO" forcez un style de chemin S3 path-style.
STORAGE_FORCE_PATH_STYLE="true"
