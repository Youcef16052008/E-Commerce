# ---- Base de données (Neon postgres) ----
# Connexion string PostgreSQL. En local : base locale ou Neon (gratuit).
DATABASE_URL="postgres://user:pass@localhost:5432/biblio"

# ---- Better Auth ----
# Secret utilisé pour signer les sessions/tokens. Génère-le avec : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-generate-a-long-random-string"

# URL de base du site (sans slash final). Laisser vide pour une auto-détection de fallback.
BETTER_AUTH_URL="http://localhost:3000"

# ---- Stripe (mode TEST uniquement) ----
# Clés de test depuis https://dashboard.stripe.com/test/apikeys
# Clés de test depuis https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
# Secret du webhook Stripe, disponible via `stripe listen` ou dans le dashboard (test)
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Code fiscal produit (option). Laissez vide pour désactiver Managed Payments (mode test sans taxe).
# Si votre compte exige une TVA, renseignez un `tax_code` Stripe éligible (ex. txcd_...).
STRIPE_TAX_CODE=""

# ---- Stockage objet (R2 / S3) pour les fichiers e-books ----
# Le serveur ne délivre que des URLs PRÉ-SIGNÉES à TTL court (15 min) :
# aucun fichier ne transite par l'app, aucune clé n'est exposée au client.
#
# MinIO local (démo, recommandé) : bash scripts/setup-minio.sh puis :
#   STORAGE_ENDPOINT=http://127.0.0.1:9000
#   STORAGE_ACCESS_KEY_ID=biblioapp
#   STORAGE_SECRET_ACCESS_KEY=biblioapp-secret
#   STORAGE_REGION=us-east-1
#   STORAGE_FORCE_PATH_STYLE=true
#
# Cloudflare R2 (production) : renseigner STORAGE_ACCOUNT_ID (l'endpoint
# https://<account>.r2.cloudflarestorage.com est déduit) — path-style est
# aussi la forme canonique de R2, on garde STORAGE_FORCE_PATH_STYLE=true.
STORAGE_ACCOUNT_ID=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="biblio"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
# true (défaut) = style de chemin endpoint/bucket/cle (MinIO ET R2).
# Mettre "false" uniquement pour un virtual-host style explicite.
STORAGE_FORCE_PATH_STYLE="true"

# ---- Import de catalogue (Project Gutenberg via Gutendex) ----
# Le site importe (métadonnées + EPUB + couverture) dans SA base et SON stockage :
# aucune dépendance en direct après l'import. Fichiers du domaine public,
# vendables (licence stockée par produit). Usage : npm run import:gutenberg
IMPORT_GUTENDEX_LIMIT="500"          # nombre max de livres importés
IMPORT_GUTENDEX_LANGUAGES=""         # ex. "fr,en" (vide = toutes)
IMPORT_PRICE_CENTS="50"              # 0,50 USD (minimum Stripe)
IMPORT_PUBLISHED="true"              # publier immédiatement dans le catalogue
IMPORT_MIN_DOWNLOADS="0"             # filtre qualité (nombre de téléchargements)

# =====================================================================
#  PRODUCTION (Vercel + Neon + R2) — Slice 10
#  Ces valeurs se configurent dans le dashboard Vercel (Project → Settings
#  → Environment Variables), sur les scopes **Production** ET **Preview**.
#  Ne JAMAIS committer les vraies valeurs : ce fichier est un exemple.
#  Runbook complet : docs/runbook-deploy.md
# =====================================================================

# ---- Base de données (Neon, branche `production`) ----
# Console Neon → project → branch `production` → connection string.
# Vercel : préfixer avec `?pg=1` inutile ici ; la pooler pgbouncer est
# optionnelle (Neon direct convient au MVP).
DATABASE_URL="postgres://USER:PASSWORD@ep-xxxx-x.region.aws.neon.tech/biblio?sslmode=require"

# ---- Better Auth (PRODUCTION) ----
# ⚠️ CRITIQUE : BETTER_AUTH_URL doit être l'URL HTTPS PUBLIQUE de la
#    production (ex. https://biblio.vercel.app), SANS slash final.
#    Sinon les cookies de session sont émis sur le mauvais domaine →
#    connexion cassée (le site semble « ne pas se souvenir » de l'utilisateur).
BETTER_AUTH_URL="https://VOTRE-SITE.vercel.app"
# Secret LONG et aléatoire (≥ 32 octets) — à régénérer pour la prod :
#   openssl rand -base64 32
BETTER_AUTH_SECRET="GENERER-EN-PROD-AVEC-openssl-rand-base64-32"

# ---- Stripe (mode TEST — compte test uniquement) ----
# Dashboard Stripe (mode test) → Developers → API keys.
STRIPE_SECRET_KEY="sk_test_vraie_cle_de_test"
# Webhook : créé via la CLI (voir runbook §4) :
#   stripe listen --forward-to VOTRE-SITE.vercel.app/api/webhooks/stripe
# puis dashboard → Developers → Webhooks → endpoint /api/webhooks/stripe
# → event `checkout.session.completed` → secret « Signing secret ».
STRIPE_WEBHOOK_SECRET="whsec_vraie_cle_webhook"
# Code fiscal (option, vide = Managed Payments désactivé en mode test).
STRIPE_TAX_CODE=""

# ---- Stockage objet (Cloudflare R2) ----
# Console R2 → bucket `biblio` → « Manage R2 API Tokens » → token « Object
# Read & Write ». L'endpoint est déduit de STORAGE_ACCOUNT_ID :
#   https://<STORAGE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCOUNT_ID="votre-id-compte-r2"
STORAGE_ACCESS_KEY_ID="key_id_du_token_r2"
STORAGE_SECRET_ACCESS_KEY="secret_du_token_r2"
STORAGE_BUCKET="biblio"
STORAGE_ENDPOINT=""                  # déduit depuis STORAGE_ACCOUNT_ID (R2)
STORAGE_REGION="auto"
STORAGE_FORCE_PATH_STYLE="true"      # style de chemin = forme canonique R2
# Les fichiers (EPUB/couvertures) sont uploadés HORS request path :
#   npm run books:upload / npm run import:gutenberg (runbook §2-3).
